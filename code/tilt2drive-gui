def presets_lista():
    """Nomes (sem extensão) dos presets salvos, em ordem alfabética."""
    nomes = set()
    for d in (PRESETS_DIR, PRESETS_DIR_OLD):   # lê os dois (migração)
        try:
            nomes |= {f[:-5] for f in os.listdir(d) if f.endswith('.conf')}
        except OSError:
            pass
    return sorted(nomes)


def preset_path(nome):
    """Caminho do arquivo do preset; nome já deve estar saneado."""
    os.makedirs(PRESETS_DIR, exist_ok=True)   # grava no dir novo
    novo = os.path.join(PRESETS_DIR, nome + '.conf')
    velho = os.path.join(PRESETS_DIR_OLD, nome + '.conf')
    if os.path.exists(novo):
        return novo
    if os.path.exists(velho):                   # preset antigo: gerencia lá
        return velho
    return novo


