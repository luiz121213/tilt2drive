    def _cb_ignorar(self):
        """Botão: o jogo deixa de ver (ou volta a ver) o DualSense físico.
        Captura exclusiva evdev — sem root, reversível no toggle e em
        qualquer queda (kernel libera quando o fd fecha)."""
        novo = not bool(self.engine._grab_quer)
        self.engine.set_ignorar(novo)

    def _toggle_motor(self):
        eng = self.engine
        if eng.is_alive():
            eng.encerrar()
            eng.join(timeout=2.5)
            self.btn_motor.configure(text=_t('LIGAR MOTOR'), fg_color=COR_OK,
                                     hover_color='#008a4c')
        else:
            novo = Engine(self.cfg)
            if eng._grab_quer:          # modo "ignorar" sobrevive à religada
                novo._grab_quer = True
                novo.state['ignorar'] = True
            self.engine = novo
            self.btn_motor.configure(text=_t('PARAR MOTOR'), fg_color=COR_ACAO,
                                     hover_color=COR_HOVER)
            novo.start()

    def _salvar(self):
        try:
            salvar_config(self.cfg)
            with self.engine._lock:
                self.engine._logs.append(_t('config salva em %s')
                                         % CONF_PATH)
        except OSError as e:
            with self.engine._lock:
                self.engine._logs.append(_t('erro ao salvar: %s') % e)

    def _fechar(self):
        self.engine.encerrar()
        try:
            self.engine.join(timeout=2.5)
        except RuntimeError:
            pass
        self.root.destroy()

    # ---------------------------------------------------------- desenho
    def _tick(self):
        st = self.engine.snapshot()
        self.historico.append(st['angle'])
        self._desenhar()
        self._atualizar_texto(st)
        self._realce_botoes(st.get('botoes'), st.get('virtual'))
        ign = bool(st.get('ignorar'))
        if getattr(self, '_ignorar_ultimo', None) is not ign:
            self._ignorar_ultimo = ign
            try:
                sw = self._sw_ignorar
                if bool(sw.get()) is not ign:
                    (sw.select if ign else sw.deselect)()
                self.lbl_ign.configure(
                    text_color=COR_ACAO if ign else COR_MUT)
            except Exception:
                pass
        self.root.after(33, self._tick)

    def _realce_botoes(self, ativos, ligado):
        """Acende em azul o botão pressionado no desenho do DualSense."""
        if not ligado:
            ativos = ()
        novo = frozenset(ativos or ())
        if novo == self._botoes_ultimo:
            return
        self._botoes_ultimo = novo
        if not self._mapa_canv or not self._mapa_canv.winfo_exists():
            return
        if self._mapa_modo == 'imagem':
            for nome, item in self._mapa_vis.items():
                try:
                    if nome in novo:
                        self._mapa_canv.itemconfig(item, outline=COR_ACAO,
                                                   width=3, dash='')
                    else:
                        self._mapa_canv.itemconfig(
                            item, outline=COR_GRADE, width=1, dash=(3, 2))
                except Exception:
                    pass
            return
        for nome, item in self._mapa_vis.items():
            cor = COR_ACAO if nome in novo else self._mapa_base.get(
                nome, '#3a3f4e')
            try:
                self._mapa_canv.itemconfig(item, fill=cor)
            except Exception:
                pass

    def _atualizar_texto(self, st):
        txt_st = st['status']
        if len(txt_st) > 34:
            txt_st = txt_st[:33] + '…'
        self.lbl_status.configure(text=txt_st, text_color=st['cor'])
        disp = self.engine.cfg.get('dispositivo', {}).get('modo', 'xbox')
        extra = ' · %s · %s (%s)' % (
            st['hidraw'], Steer.PERFIL.get(disp, Steer.PERFIL['xbox'])['name'],
            disp) if st['virtual'] else \
                ' · %s' % st['hidraw'] if st['hidraw'] else ''
        self.lbl_hid.configure(
            text='%s%.0f rel/s' % (extra + ' · ', st['rps'])
            if st['rps'] else extra)
        eix_novo = st.get('eixo_detectado')
        if eix_novo is not None:
            if hasattr(self, '_var_eixo'):
                self._var_eixo.set(['x', 'y', 'z'][min(2, max(0, eix_novo))])
            with self.engine._lock:
                self.engine.state['eixo_detectado'] = None
        pr = st.get('pedal_rest', (0.0, 0.0))
        if pr and hasattr(self, 'lbl_pedais'):
            self.lbl_pedais.configure(
                text=_t('repouso: freio %.0f / acel %.0f (subtraído)')
                     % (pr[0], pr[1]))
        logs = self.engine.logs()
        self.txt_logs.config(state='normal')
        self.txt_logs.delete('1.0', 'end')
        if logs:
            self.txt_logs.insert('end', '\n'.join(logs[-5:]))
        self.txt_logs.config(state='disabled')

    def _rrect(self, c, x1, y1, x2, y2, r=10, fill=COR_CARD,
               outline=None, width=1):
        """Retângulo com cantos arredondados (polígono suavizado)."""
        r = max(0.0, min(r, (x2 - x1) / 2.0, (y2 - y1) / 2.0))
        pts = (x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r,
               x2, y2, x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r,
               x1, y1 + r, x1, y1)
        kw = {'fill': fill, 'outline': outline or fill,
              'width': width, 'smooth': True}
        return c.create_polygon(*pts, **kw)

    def _desenhar(self):
        c = self.canv
        c.delete('all')
        w = c.winfo_width() or 940
        h = c.winfo_height() or 290
        st = self.engine.snapshot()
        amax = max(5.0, float(M.cfg_direcao(self.cfg).get(
            'angulo_max', 45.0)))
        gir_max = max(90.0, float(self.cfg.get('volante', {}).get(
            'gir_max', 900.0)))
        frei, acel = st.get('pedais') or (0.0, 0.0)

        # ---- coluna do volante (direita) ----
        colx = w - 280
        if self._wheel_pil:
            sz = max(120, min(164, h - 140))
            rotd = max(-gir_max, min(gir_max, st['angle'] / amax * gir_max))
            st_rod = '%+.0f°' % rotd
            if self._wheel_rot is None or \
                    abs(rotd - self._wheel_rot) > 0.5 or sz != self._wheel_sz:
                self._wheel_rot = rotd
                self._wheel_sz = sz
                res = getattr(Image, 'Resampling', Image)
                rot = self._wheel_pil.rotate(-rotd, resample=res.BICUBIC)
                self._wheel_tk = ImageTk.PhotoImage(
                    rot.resize((sz, sz), Image.LANCZOS))
            wx = colx + (w - colx) // 2
            wy = sz // 2 + 22
            c.create_image(wx, wy, image=self._wheel_tk)
            c.create_text(wx, wy + sz / 2 + 14, text='volante ' + st_rod,
                          fill=COR_TXT, font=('DejaVu Sans Mono', 12, 'bold'))
            c.create_text(wx, wy + sz / 2 + 29,
                          text='rotação total ±%.0f°' % gir_max,
                          fill=COR_MUT, font=('DejaVu Sans Condensed', 10))
        else:
            colx = w - 30       # sem imagem: layout anterior

        # ---- barras dos pedais (esquerda, HUD de corrida) ----
        barw, gap = 44, 26
        px0 = 18
        pt = 34
        pb = h - 62
        if pb - pt >= 60:
            for x, val, cor, rot in ((px0, acel, COR_OK, 'R2 acel.'),
                                     (px0 + barw + gap, frei, COR_FREIO,
                                      'L2 freio')):
                c.create_text(x + barw // 2, pt - 16, text=rot,
                              fill=COR_MUT, font=F_SUP)
                self._rrect(c, x, pt, x + barw, pb, 10,
                            fill=COR_CARD, outline=COR_GRADE)
                fh = (pb - pt) * max(0.0, min(1.0, val))
                if fh > 2.0:
                    self._rrect(c, x + 3, pb - fh, x + barw - 3, pb - 3, 7,
                                fill=cor)
                c.create_text(x + barw // 2, pb + 16,
                              text='%3.0f%%' % (val * 100.0),
                              fill=cor, font=('DejaVu Sans Mono', 12, 'bold'))
            midx = px0 + 2 * barw + gap
        else:
            midx = px0

        # ---- card central: histórico de ângulo ----
        mx0, mx1 = midx + 22, colx - 18
        if mx1 - mx0 >= 140:
            gy0, gy1 = 26, h - 152
            self._rrect(c, mx0, gy0, mx1, gy1, 12, fill=COR_CARD,
                        outline=COR_GRADE)
            meio = (gy0 + gy1) / 2
            c.create_line(mx0 + 10, meio, mx1 - 10, meio,
                          fill='#3a4050', dash=(4, 4))
            c.create_text(mx0 + 12, gy0 + 6, anchor='nw',
                          text='ângulo · últimos ~%ds' % (JANELA_HIST / 30.0),
                          fill=COR_MUT, font=F_SUP)
            c.create_text(mx1 - 12, gy0 + 6, anchor='ne',
                          text='escala ±%.0f°' % amax,
                          fill=COR_MUT, font=F_SUP)
            n = len(self.historico)
            if n > 2:
                passo_x = (mx1 - mx0 - 20) / (JANELA_HIST - 1.0)
                pts = []
                for i, a in enumerate(self.historico):
                    x = mx1 - 10 - i * passo_x
                    y = meio - max(-1.0, min(1.0, a / amax)) * \
                        (gy1 - gy0) / 2 * 0.85
                    pts.append(x)
                    pts.append(y)
                c.create_line(*pts, fill=COR_EIXO, width=2, smooth=True)

            # ---- barra de esterço ----
            by = gy1 + 18
            bh = 26
            nome_dev = Steer.PERFIL.get(
                self.cfg.get('dispositivo', {}).get('modo', 'xbox'),
                Steer.PERFIL['xbox'])['name']
            c.create_text(mx0, by - 16, anchor='w', fill=COR_MUT,
                          font=F_SUP,
                          text='esterço no device virtual "%s": %+05.1f%%'
                               % (nome_dev, st['out'] * 100.0))
            self._rrect(c, mx0, by, mx1, by + bh, 12, fill=COR_CARD,
                        outline=COR_GRADE, width=2)
            c.create_line((mx0 + mx1) / 2, by, (mx0 + mx1) / 2, by + bh,
                          fill=COR_GRADE)
            kx = (mx0 + mx1) / 2 + max(-1.0, min(1.0, st['out'])) * \
                (mx1 - mx0 - 30) / 2
            c.create_oval(kx - 12, by + 1, kx + 12, by + bh - 1,
                          fill=COR_NEEDLE, outline='#1a1b20')
            c.create_text(mx0 + 6, by + bh + 4, text='esquerda', anchor='nw',
                          fill=COR_MUT, font=F_SUP)
            c.create_text(mx1 - 6, by + bh + 4, text='direita', anchor='ne',
                          fill=COR_MUT, font=F_SUP)
            # ---- telemetria em números ----
            ny = by + bh + 30
            if ny < h - 12:
                fnum = 13 if mx1 - mx0 >= 640 else 11
                c.create_text(mx0, ny, anchor='w', fill=COR_TXT,
                              font=('DejaVu Sans Mono', fnum, 'bold'),
                              text='ângulo %+07.2f°   esterço %+05.1f%%   '
                                   'giro %+07.1f°/s   |a| %.2f g'
                                   % (st['angle'], st['out'] * 100.0,
                                      st['dps'], st['ga']))
                c.create_text(mx0, ny + 17, anchor='w', fill=COR_MUT,
                              font=F_SUP,
                              text='acel (x %+0.2f, y %+0.2f, z %+0.2f g)'
                                   % st['accel_g'])

def a_linha(i):
    """Linha do grid dado o índice do slider (3 por linha)."""
    return i // 3


def main():
    ap = argparse.ArgumentParser(description='GUI do tilt2drive')
    ap.add_argument('--selftest', action='store_true')
    args = ap.parse_args()
    ui = ler_ui(CONF_LER)
    global LINGUA
    LINGUA = ui['idioma'] if ui['idioma'] in ('pt', 'en') else 'pt'
    _aplicar_tokens(ui['tema'])
    ctk.set_appearance_mode('light' if TEMA_ATIVO == 'claro' else 'dark')
    cfg = M.load_cfg(CONF_LER)
    cfg['ui'] = ui
    app = App(cfg)
    if args.selftest:
        for _ in range(8):
            app.root.update()
            time.sleep(0.02)
        st = app.engine.snapshot()
        print('selftest OK — status: %r | hidraw: %r'
              % (st['status'], st['hidraw']))
        app._fechar()
        return
    app.root.mainloop()


if __name__ == '__main__':
    main()
