    def _mapa_no(self, x, y):
        """Nome do botão do mapa sob (x, y): primeiro por raio (anéis),
        depois por retângulo (touchpad). None se fora de tudo."""
        for nome, (cx, cy, r) in self._mapa_ptos.items():
            if (x - cx) ** 2 + (y - cy) ** 2 <= (r * 1.15) ** 2:
                return nome
        for nome, (x1, y1, x2, y2) in self._mapa_ret.items():
            if x1 <= x <= x2 and y1 <= y <= y2:
                return nome
        return None

    def _mapa_fundo(self, c, liga):
        """Fundo com a arte real do DualSense (PNG convertido do SVG do
        usuario, recolorido ao tema). Retorna True se usou a imagem, com
        aneis de hotspot sobre cada botao; queda de volta no desenho."""
        caminho = os.path.join(ICONS_DIR, 'dualsense.png')
        if not (_TEM_PIL and os.path.exists(caminho)):
            return False
        try:
            im = Image.open(caminho).convert('RGBA')
            s = min(460.0 / im.width, 292.0 / im.height)
            tw, th = max(1, int(im.width * s)), max(1, int(im.height * s))
            im = im.resize((tw, th), Image.LANCZOS)
            self._mapa_img_ref = ImageTk.PhotoImage(im)   # mantem viva
        except Exception:
            return False
        dx = (640 - tw) / 2.0
        dy = 44.0
        c.create_image(dx + tw / 2.0, dy + th / 2.0,
                       image=self._mapa_img_ref)
        # hotspots em pixels da arte original (medidos na arte)
        for nome, cx, cy, r in (
                ('triangulo', 1022, 148, 47), ('quadrado', 924, 244, 45),
                ('circulo', 1120, 242, 46), ('cruz', 1022, 335, 45),
                ('cima', 235, 167, 45), ('baixo', 227, 312, 45),
                ('esquerda', 152, 237, 45), ('direita', 317, 240, 45),
                ('l3', 430, 413, 48), ('r3', 828, 413, 48),
                ('l1', 245, 32, 75), ('r1', 1040, 33, 75),
                ('create', 332, 111, 28), ('options', 934, 105, 28),
                ('ps', 637, 400, 50)):
            anel = c.create_oval(dx + (cx - r) * s, dy + (cy - r) * s,
                                 dx + (cx + r) * s, dy + (cy + r) * s,
                                 fill='', outline='#3d455e',
                                 dash=(3, 2), width=1)
            liga(nome, anel, None, clique=False)
            self._mapa_ptos[nome] = (dx + cx * s, dy + cy * s, r * s)
        tp = c.create_rectangle(dx + 378 * s, dy + 28 * s,
                                dx + 882 * s, dy + 292 * s,
                                fill='', outline='#3d455e',
                                dash=(3, 2), width=1)
        liga('touchpad', tp, None, clique=False)
        self._mapa_ret['touchpad'] = (dx + 378 * s, dy + 28 * s,
                                      dx + 882 * s, dy + 292 * s)
        self._mapa_modo = 'imagem'
        return True

    def _mapa_dialogo(self, nome):
        """Janela modal para escolher a função de um botão do DualSense."""
        mapa = self.cfg.setdefault('mapa_botoes',
                                   {k: v for k, v in
                                    Steer.MAPA_PADRAO.items()})
        atual = mapa.get(nome, Steer.MAPA_PADRAO.get(nome, 'none'))
        win = tk.Toplevel(self.root)
        win.title('Função do botão')
        win.configure(bg=COR_PAINEL)
        win.transient(self.root)
        win.resizable(False, False)
        win.protocol('WM_DELETE_WINDOW', win.destroy)
        quad = tk.Frame(win, bg=COR_PAINEL)
        quad.pack(fill='both', expand=True)
        tk.Label(quad, bg=COR_PAINEL, fg=COR_TXT,
                 font=('Segoe UI', 11, 'bold'),
                 text='"%s" → o que enviar ao device virtual:'
                 % ROTULOS_DS.get(nome, nome)).pack(
            anchor='w', padx=14, pady=(12, 4))
        tk.Label(quad, bg=COR_PAINEL, fg=COR_MUT, font=('Segoe UI', 9),
                 text='Escolha na lista e clique em Aplicar (duplo clique '
                      'também aplica).').pack(anchor='w', padx=14)
        lq = tk.Frame(quad, bg=COR_BG, bd=1, relief='flat',
                      highlightthickness=1, highlightbackground=COR_GRADE)
        lq.pack(fill='x', padx=14, pady=(8, 6))
        lb = tk.Listbox(lq, height=16, bg=COR_BG, fg=COR_TXT,
                        selectbackground='#2563eb', bd=0,
                        highlightthickness=0,
                        font=('Segoe UI', 10), activestyle='none',
                        exportselection=False)
        sb = ttk.Scrollbar(lq, orient='vertical', command=lb.yview)
        lb.configure(yscrollcommand=sb.set)
        sb.pack(side='right', fill='y')
        lb.pack(side='left', fill='both', expand=True)
        for s in Steer.SAIDAS:
            lb.insert('end', ROTULOS_SAI.get(s, s))
        idx = list(Steer.SAIDAS).index(atual) if atual in Steer.SAIDAS \
            else len(Steer.SAIDAS) - 1
        lb.selection_set(idx)
        lb.see(idx)

        def aplicar(_e=None, fechar=True):
            sel = lb.curselection()
            if sel:
                saida = Steer.SAIDAS[sel[0]]
                mapa[nome] = saida
                if nome in self._mapa_vars:
                    self._mapa_vars[nome].set(saida)
                self.engine.set_mapa(mapa)
                with self.engine._lock:
                    self.engine._logs.append('mapa: %s → %s'
                                             % (nome, saida))
            if fechar:
                win.destroy()

        rodape = tk.Frame(quad, bg=COR_PAINEL)
        rodape.pack(fill='x', padx=14, pady=(2, 12))
        self._botao(rodape, 'Aplicar', aplicar).pack(side='left')
        self._botao(rodape, 'Cancelar', win.destroy).pack(side='right')
        lb.bind('<Double-Button-1>', aplicar)
        lb.bind('<Return>', aplicar)
        lb.bind('<space>', aplicar)
        win.bind('<Escape>', lambda _e: win.destroy())
        # centrar sobre a janela principal e capturar DEPOIS de visivel
        win.update_idletasks()
        win.withdraw()
        win.deiconify()
        try:
            px, py = self.root.winfo_rootx(), self.root.winfo_rooty()
            pw = self.root.winfo_width() or 900
            ph = self.root.winfo_height() or 600
            ww, wh = win.winfo_reqwidth(), win.winfo_reqheight()
            win.geometry('+%d+%d' % (px + max(0, (pw - ww) // 2),
                                     py + max(0, (ph - wh) // 3)))
        except Exception:
            pass
        win.wait_visibility()
        win.lift()
        win.grab_set()
        win.focus_set()
        lb.focus_set()
