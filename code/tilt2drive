def cfg_direcao(cfg):
    """Seção de condução ativa, conforme o modo do dispositivo."""
    if cfg.get('dispositivo', {}).get('modo') == 'volante' \
            and 'direcao_volante' in cfg:
        return cfg['direcao_volante']
    return cfg['direcao']


# ---------------------------------------------------------------------------
# dispositivo virtual (uinput)
# ---------------------------------------------------------------------------
class Steer:
    """Dispositivo virtual (uinput), somente alimentado pela leitura do DualSense.

    Perfis (cfg['dispositivo']['modo']):
      'xbox'    - gamepad completo estilo Xbox 360 (sticks, gatilhos, dpad, botões);
      'volante' - device de volante pedido por nome ("Racing Wheel"; o F1 25 e o
                  Wine classificam por nome): ABS_X = direção de verdade,
                  ABS_Y = freio, ABS_Z = acelerador - sem caminho de stick,
                  com retorno ao centro imediato.

    cfg['mapa_botoes']: cada entrada do DualSense -> saída do device virtual
    ('a','b','x','y','lb','rb','back','start','ls','rs','guide',
     'up','down','left','right' ou 'none' = desconectado)."""

    PERFIL = {
        'xbox': {
            'name': 'Tilt2Drive Gyro Wheel',
            'bus': 0x03, 'vid': 0x045E, 'pid': 0x028E, 'ver': 0x0114,
            'eixos': {ABS_X: (-32768, 32767), ABS_Y: (-32768, 32767),
                      ABS_RX: (-32768, 32767), ABS_RY: (-32768, 32767),
                      ABS_Z: (0, 255), ABS_RZ: (0, 255),
                      ABS_HAT0X: (-1, 1), ABS_HAT0Y: (-1, 1)},
        },
        'volante': {
            # assinatura clássica de volante (Logitech G25) - Wine/F1 enxergam wheel
            'name': 'Tilt2Drive Racing Wheel',
            'bus': 0x03, 'vid': 0x046D, 'pid': 0xC29B, 'ver': 0x0110,
            'eixos': {ABS_X: (-32768, 32767),          # direção
                      ABS_Y: (0, 1023),                # freio
                      ABS_Z: (0, 1023),                # acelerador
                      ABS_HAT0X: (-1, 1), ABS_HAT0Y: (-1, 1)},
        },
    }

    # saídas possíveis do device virtual (xbox / teclas do teclado p/ menus)
    SAIDAS = ('a', 'b', 'x', 'y', 'lb', 'rb', 'back', 'start', 'ls', 'rs',
              'guide', 'up', 'down', 'left', 'right', 'none',
              'w1', 'w2', 'w3', 'w4', 'w5', 'w6', 'w7', 'w8', 'w9', 'w10',
              'w11', 'w12', 'enter', 'esc', 'k_up', 'k_down', 'k_left',
              'k_right')
    _BOTAO = {
        'a': (EV_KEY, BTN_SOUTH), 'b': (EV_KEY, BTN_EAST),
        'x': (EV_KEY, BTN_NORTH), 'y': (EV_KEY, BTN_WEST),
        'lb': (EV_KEY, BTN_TL), 'rb': (EV_KEY, BTN_TR),
        'back': (EV_KEY, BTN_SELECT), 'start': (EV_KEY, BTN_START),
        'ls': (EV_KEY, BTN_THUMBL), 'rs': (EV_KEY, BTN_THUMBR),
        'guide': (EV_KEY, BTN_MODE),
    }
    # família 0x120: os códigos que um G27 real emite (F1 25 mapeia por código)
    _BOTAO_W = {
        'w1': BTN_TRIGGER, 'w2': BTN_THUMB, 'w3': BTN_THUMB2,
        'w4': BTN_TOP, 'w5': BTN_TOP2, 'w6': BTN_PINKIE,
        'w7': BTN_BASE, 'w8': BTN_BASE2, 'w9': BTN_BASE3,
        'w10': BTN_BASE4, 'w11': BTN_BASE5, 'w12': BTN_BASE6,
    }
    # teclas reais: F1 25 navega menus por teclado sempre
    _K_TECLA = {'enter': KEY_ENTER, 'esc': KEY_ESC,
                'k_up': KEY_UP, 'k_down': KEY_DOWN,
                'k_left': KEY_LEFT, 'k_right': KEY_RIGHT}

    # entradas do DualSense: nome -> (byte relativo ao base, máscara)
    ENTRADAS = (
        ('quadrado', 0, 0x10), ('cruz', 0, 0x20),
        ('circulo', 0, 0x40), ('triangulo', 0, 0x80),
        ('l1', 1, 0x01), ('r1', 1, 0x02),
        ('create', 1, 0x10), ('options', 1, 0x20),
        ('l3', 1, 0x40), ('r3', 1, 0x80),
        ('ps', 2, 0x01), ('touchpad', 2, 0x02),
    )
    DS_NAMES = tuple(n for n, _, _ in ENTRADAS) + \
        ('cima', 'baixo', 'esquerda', 'direita')

    MAPA_PADRAO = {
        'cruz': 'a', 'circulo': 'b', 'quadrado': 'x', 'triangulo': 'y',
        'l1': 'lb', 'r1': 'rb', 'create': 'back', 'options': 'start',
        'l3': 'ls', 'r3': 'rs', 'ps': 'guide', 'touchpad': 'none',
        'cima': 'up', 'baixo': 'down', 'esquerda': 'left', 'direita': 'right',
    }

    def __init__(self, modo='xbox', mapa=None, volante=None):
        self.modo = modo if modo in self.PERFIL else 'xbox'
        self._pedais = {
            # pedal: (zona_morta, curva, repouso)
            'freio': (20.0, 1.0, 0.0),
            'acel': (20.0, 1.0, 0.0),
        }
        if isinstance(volante, dict):
            self.set_pedais(volante.get('freio_zona_morta', 20.0),
                            volante.get('freio_curva', 1.0),
                            volante.get('acel_zona_morta', 20.0),
                            volante.get('acel_curva', 1.0),
                            volante.get('freio_repouso', 0.0),
                            volante.get('acel_repouso', 0.0))
        self.set_mapa(mapa)

    def set_pedais(self, freio_dz=20.0, freio_curva=1.0, acel_dz=20.0,
                   acel_curva=1.0, freio_rep=0.0, acel_rep=0.0):
        """Ajuste dos pedais do modo volante (zona morta, curva, repouso)."""
        def clamp(dz, curva, rep):
            return (max(0.0, min(120.0, float(dz))),
                    max(0.3, min(3.0, float(curva))),
                    max(0.0, min(120.0, float(rep))))
        self._pedais = {
            'freio': clamp(freio_dz, freio_curva, freio_rep),
            'acel': clamp(acel_dz, acel_curva, acel_rep),
        }

    def set_mapa(self, mapa=None):
        """Redefine o mapa de botões ao vivo (device não precisa ser recriado)."""
        mapping = dict(self.MAPA_PADRAO)
        if isinstance(mapa, dict):
            for k, v in mapa.items():
                if k in self.DS_NAMES and v in self.SAIDAS:
                    mapping[k] = v
        self.mapping = mapping
        self._rev = {}          # saída -> entradas do DualSense que a disparam
        for ds, saida in mapping.items():
            if saida in self._BOTAO or saida in self._BOTAO_W:
                self._rev.setdefault(saida, []).append(ds)
        self._hat_in = {'up': [], 'down': [], 'left': [], 'right': []}
        for ds, saida in mapping.items():
            if saida in self._hat_in:
                self._hat_in[saida].append(ds)

        p = self.PERFIL[self.modo]
        self._eixos = p['eixos']
        self._botoes = tuple(self._BOTAO[k][1] for k in self._BOTAO) + \
            tuple(self._BOTAO_W[k] for k in self._BOTAO_W)
        self.fd = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY, True)
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_ABS, True)
            for code in self._eixos:
                fcntl.ioctl(self.fd, UI_SET_ABSBIT, code, True)
            for code in self._botoes:
                fcntl.ioctl(self.fd, UI_SET_KEYBIT, code, True)
            self._create_dev(p)
        except Exception:
            os.close(self.fd)
            raise
        self._state = {}

    def _create_dev(self, p):
        # struct uinput_user_dev: name[80], input_id(4x u16), ff_effects_max(u32),
        # absmax[64], absmin[64], absfuzz[64], absflat[64]
        pack = '=80sHHHHI' + '64i' * 4
        absmax = [0] * 64
        absmin = [0] * 64
        fuzz = [0] * 64
        flat = [0] * 64
        for code, (lo, hi) in self._eixos.items():
            absmin[code] = lo
            absmax[code] = hi
            fuzz[code] = 8
            if code in (ABS_X, ABS_Y, ABS_Z, ABS_RX, ABS_RY, ABS_RZ):
                flat[code] = 4            # centro limpo (evita jitter)
        data = struct.pack(pack, p['name'].encode('utf-8')[:78].ljust(80, b'\0'),
                           p['bus'], p['vid'], p['pid'], p['ver'], 0,
                           *absmax, *absmin, *fuzz, *flat)
        os.write(self.fd, data)
        ret = fcntl.ioctl(self.fd, UI_DEV_CREATE, struct.pack('i', 0), True)
        if isinstance(ret, bytes):
            ret = struct.unpack('i', ret[:4])[0]
        if ret != 0:
            raise OSError('UI_DEV_CREATE falhou (%s)' % ret)

    def _ev(self, eventos, tipo, cod, val):
        if self._state.get((tipo, cod)) != val:
            self._state[(tipo, cod)] = val
            eventos.extend(struct.pack(INPUT_EVENT, 0, 0, tipo, cod, val))

    def emit(self, value):
        ev = bytearray()
        self._ev(ev, EV_ABS, ABS_X, value)
        if ev:
            try:
                os.write(self.fd, bytes(ev)
                         + struct.pack(INPUT_EVENT, 0, 0, 0, 0, 0))
            except OSError:
                pass

    def feed(self, buf, steer_value, base):
        """Reposta o estado completo do DualSense (via mapa) + direção do giroscópio."""
        b = buf
        apert = {}
        for nome, nbyte, mask in self.ENTRADAS:
            apert[nome] = bool(b[base + 7 + nbyte] & mask)
        apert.setdefault('cima', False)
        apert.setdefault('baixo', False)
        apert.setdefault('esquerda', False)
        apert.setdefault('direita', False)
        nib = b[base + 7] & 0x0F
        hatx, haty = DS_HAT[nib] if nib < len(DS_HAT) else (0, 0)
        apert['cima'] |= haty < 0
        apert['baixo'] |= haty > 0
        apert['esquerda'] |= hatx < 0
        apert['direita'] |= hatx > 0

        ev = bytearray()
        self._ev(ev, EV_ABS, ABS_X, steer_value)
        if self.modo == 'xbox':
            self._ev(ev, EV_ABS, ABS_Y, (b[base + 1] - 128) * 257)
            self._ev(ev, EV_ABS, ABS_RX, (b[base + 2] - 128) * 257)
            self._ev(ev, EV_ABS, ABS_RY, (b[base + 3] - 128) * 257)
            self._ev(ev, EV_ABS, ABS_Z, b[base + 4])       # gatilho esquerdo
            self._ev(ev, EV_ABS, ABS_RZ, b[base + 5])      # gatilho direito
        else:  # volante: pedais analógicos (L2 = freio, R2 = acelerador)
            self._ev(ev, EV_ABS, ABS_Y, self._pedal(b[base + 4], 'freio'))
            self._ev(ev, EV_ABS, ABS_Z, self._pedal(b[base + 5], 'acel'))

        # dpad virtual a partir do mapa (várias entradas podem mapear p/ cima etc.)
        hx = hy = 0
        for ds in self._hat_in['up']:
            if apert[ds]:
                hy = -1
        for ds in self._hat_in['down']:
            if apert[ds]:
                hy = 1
        for ds in self._hat_in['left']:
            if apert[ds]:
                hx = -1
        for ds in self._hat_in['right']:
            if apert[ds]:
                hx = 1
        self._ev(ev, EV_ABS, ABS_HAT0X, hx)
        self._ev(ev, EV_ABS, ABS_HAT0Y, hy)

        # botões: cada saída acesse se QUALQUER entrada mapeada para ela
        for saida, (tipo, cod) in self._BOTAO.items():
            if saida not in self._rev:
                continue
            val = 1 if any(apert[ds] for ds in self._rev[saida]) else 0
            self._ev(ev, tipo, cod, val)
        for saida, cod in self._BOTAO_W.items():
            if saida not in self._rev:
                continue
            val = 1 if any(apert[ds] for ds in self._rev[saida]) else 0
            self._ev(ev, EV_KEY, cod, val)
        # teclas (menus do F1 25 respondem a teclado de teclado)
        if any(s in self._K_TECLA for s in self._rev):
            self._teclado_criar()
            if self.kfd and self.kfd > 0:
                kv = bytearray()
                for saida, cod in self._K_TECLA.items():
                    if saida not in self._rev:
                        continue
                    val = 1 if any(apert[ds] for ds in self._rev[saida]) \
                        else 0
                    self._ev(kv, EV_KEY, cod, val)
                if kv:
                    try:
                        os.write(self.kfd, bytes(kv)
                                 + struct.pack(INPUT_EVENT, 0, 0, 0, 0,
                                               0))
                    except OSError:
                        pass
        if ev:
            try:
                os.write(self.fd, bytes(ev)
                         + struct.pack(INPUT_EVENT, 0, 0, 0, 0, 0))
            except OSError:
                pass

    def _teclado_criar(self):
        """Mini device de teclado virtual (só as teclas de navegador)."""
        if getattr(self, 'kfd', None):
            return
        fd = None
        try:
            fd = os.open('/dev/uinput',
                         os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY, True)
            for cod in self._K_TECLA.values():
                fcntl.ioctl(fd, UI_SET_KEYBIT, cod, True)
            zeros = [0] * 64
            data = struct.pack('=80sHHHHI' + '64i' * 4,
                               'Tilt2Drive Virtual Keys'.encode()[:78]
                               .ljust(80, b'\0'), 0x03, 0x046D, 0xCAF1,
                               0x0110, 0, *zeros, *zeros, *zeros, *zeros)
            os.write(fd, data)
            ret = fcntl.ioctl(fd, UI_DEV_CREATE, struct.pack('i', 0), True)
            if isinstance(ret, bytes):
                ret = struct.unpack('i', ret[:4])[0]
            if ret != 0:
                raise OSError('UI_DEV_CREATE falhou (%s)' % ret)
            self.kfd = fd
        except OSError:
            if fd is not None:
                os.close(fd)   # falhou: sem teclado (não fatal)
            self.kfd = -1

    def _pedal(self, raw, nome='acel'):
        """Byte cru do gatilho (0-255) -> 0-1020 com repouso, zona morta e curva."""
        dz, curva, rep = self._pedais.get(nome, (0.0, 1.0, 0.0))
        v = raw - rep                    # gatilho em repouso vira 0
        # piso absoluto: alguns valores de jitter do gatilho em repouso
        # não podem sangrar gás/freio mesmo com zona morta do usuário em 0
        dz = max(dz, 5.0)
        if v <= dz:
            return 0
        curso = 255.0 - rep - dz         # curso útil restante
        norm = (v - dz) / max(1.0, curso)
        return int(min(1020, round((norm ** curva) * 1020.0)))

    def reset(self):
        self._state = {}       # força re-envio de todo o estado no próximo feed
        self.emit(0)

    def close(self):
        try:
            self.emit(0)
            self._state = {}
            fcntl.ioctl(self.fd, UI_DEV_DESTROY, struct.pack('i', 0), True)
        finally:
            os.close(self.fd)
        kfd = getattr(self, 'kfd', None)
        if kfd and kfd > 0:
            try:
                fcntl.ioctl(kfd, UI_DEV_DESTROY, struct.pack('i', 0), True)
            except OSError:
                pass
            os.close(kfd)
            self.kfd = None


def botoes_apertados(buf, base):
    """Nomes das entradas (DS_NAMES) pressionadas neste relatório."""
    if len(buf) < base + 10:
        return ()
    apertados = [n for n, nb, mask in Steer.ENTRADAS
                 if buf[base + 7 + nb] & mask]
    nib = buf[base + 7] & 0x0F
    if nib < len(DS_HAT):
        hatx, haty = DS_HAT[nib]
        if haty < 0:
            apertados.append('cima')
        elif haty > 0:
            apertados.append('baixo')
        if hatx < 0:
            apertados.append('esquerda')
        elif hatx > 0:
            apertados.append('direita')
    return tuple(apertados)


