def _t(s):
    return TR.get(LINGUA, {}).get(s, s)


def ler_ui(path):
    """Seção [ui] do conf: tema/idioma da interface (padrão: escuro/pt)."""
    cp = configparser.ConfigParser(strict=False)
    cp.read(path)
    get = lambda k, d: cp.get('ui', k, fallback=d).strip().lower() \
        if cp.has_section('ui') else d
    return {'tema': get('tema', 'escuro'), 'idioma': get('idioma', 'pt')}

