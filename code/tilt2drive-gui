class Engine(threading.Thread):
    """Motor: lê o hidraw, calibra, cria o volante virtual e publica o estado."""

    def __init__(self, cfg):
        super().__init__(daemon=True)
        self.cfg = cfg
        self.sensor = None
        self._stop = False
        self._recal = False
        self._reopen = False
        self._ult_botoes = ()
        self._trocar_modo = False
        self._steer = None
        self._lock = threading.Lock()
        self._grab_quer = False    # o jogo deve ignorar o controle físico?
        self._grab_fds = []        # fds evdev capturados com EVIOCGRAB
        self._grab_caminho = ''    # hidraw vigente quando o grab foi feito
        self._nrep = 0
        self.state = {
            'status': _t('iniciando...'), 'cor': COR_MUT, 'hidraw': '',
            'angle': 0.0, 'out': 0.0, 'dps': 0.0,
            'accel_g': (0.0, 0.0, 0.0), 'ga': 0.0, 'rps': 0.0,
            'pedais': (0.0, 0.0),
            'eixos': None, 'virtual': False, 'eixo_detectado': None,
            'pedal_rest': (0.0, 0.0), 'botoes': (),
            'cor': COR_MUT, 'status': _t('iniciando...'),
        }
        self._logs = deque(maxlen=8)
        M.log = self._module_log   # captura os logs do módulo (calibração etc.)

    # ---- jogo ignora o controle físico (EVIOCGRAB nos evdev) ----
    def set_ignorar(self, val):
        """Liga/desliga o modo "o jogo ignora o controle original".

        Como funciona: abre os nodes evdev do DualSense em SO LEITURA e
        toma a posse com EVIOCGRAB — nenhum outro processo (jogo, Steam)
        recebe mais eventos do controle físico, enquanto este motor segue
        lendo o hidraw normalmente. Reversível por construção: os fds
        fecham no desligar, no fechar do app ou até em queda, e o KERNEL
        solta o grab automaticamente. Sem escrita, sem udev, sem root."""
        val = bool(val)
        with self._lock:
            self._grab_quer = val
            self.state['ignorar'] = val
            hid = self.state.get('hidraw', '')
        if val:
            n = self._grab_renovar(hid)
            msg = (_t('jogo vai ignorar o controle físico: %d node(s) '
                      'capturado(s)') % n if n else
                   _t('ignorar: nenhum node do DualSense capturado — '
                      'controle presente?'))
            with self._lock:
                self._logs.append(msg)
        else:
            n = self._grab_soltar()
            if n:
                with self._lock:
                    self._logs.append(_t('controle físico devolvido ao '
                                         'sistema (%d node(s))') % n)

    def _grab_renovar(self, hid_atual):
        """Refaz a captura (fecha os fds antigos e reabre os nodes atuais)."""
        self._grab_soltar()
        fds = self._grab_segurar()
        with self._lock:
            self._grab_fds = fds
            self._grab_caminho = hid_atual or self._grab_caminho
        return len(fds)

    def _grab_soltar(self):
        """Fecha os fds capturados: o kernel libera o EVIOCGRAB sozinho."""
        with self._lock:
            fds = self._grab_fds
            self._grab_fds = []
        n = 0
        for fd in fds:
            try:
                os.close(fd)
                n += 1
            except OSError:
                pass
        return n

    def _grab_segurar(self):
        """Enumera os nodes evdev do DualSense (vendor 054c) e captura."""
        achados = []
        for node in sorted(glob.glob('/dev/input/event[0-9]*')):
            devdir = os.path.join('/sys/class/input',
                                  os.path.basename(node), 'device')
            try:
                with open(os.path.join(devdir, 'name'), encoding='utf-8',
                          errors='replace') as fh:
                    nome_dev = fh.read()
                if 'DualSense' not in nome_dev and \
                        'Wireless Controller' not in nome_dev:
                    continue   # USB: "...DualSense Wireless Controller"/
                               #  BT:  "...Wireless Controller" (sem DualSense)
                with open(os.path.join(devdir, 'device', 'id', 'vendor'),
                          encoding='ascii') as fh:
                    if int(fh.read().strip(), 16) != 0x054C:
                        continue
            except (OSError, ValueError):
                continue
            fd = None
            try:
                fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK |
                             os.O_CLOEXEC)
                fcntl.ioctl(fd, EVIOCGRAB, 1, True)
            except OSError:
                if fd is not None:
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                continue
            achados.append(fd)
        return achados

    def _grab_renovar_se(self, path_atual):
        """Loop do motor chama ao (re)abrir o hidraw: se 'ignorar' on e o
        dispositivo trocou, refaz a captura dos novos nodes."""
        with self._lock:
            precisa = self._grab_quer and self._grab_caminho != path_atual
        if not precisa:
            return
        n = self._grab_renovar(path_atual)
        with self._lock:
            self._logs.append(_t('grab renovado p/ o novo device: '
                                 '%d node(s)') % n)

    # ---- comunicação com a GUI ----
    def _module_log(self, msg='', end='\n'):
        s = str(msg)
        if s.strip():
            with self._lock:
                self._logs.append(s.rstrip('.') or '.')

    def status(self, txt, cor=None):
        with self._lock:
            self.state['status'] = txt
            if cor:
                self.state['cor'] = cor

    def snapshot(self):
        with self._lock:
            return dict(self.state)

    def logs(self):
        with self._lock:
            return list(self._logs)

    def recalibrar(self):
        self._recal = True

    def set_eixo_fixo(self, eixo):
        """Trava (ou libera, com -1) o eixo de giro e recalibra na hora."""
        self.cfg.setdefault('sensor', {})['eixo_giro'] = int(eixo)
        self._recal = True

    def _persistir_calibracao(self, sensor):
        """Guarda eixo/sinal/escala detectados (se o usuário permitiu)."""
        cfg_s = self.cfg.setdefault('sensor', {})
        vol = self.cfg.setdefault('volante', {})
        with self._lock:
            self.state['eixo_detectado'] = sensor.gyro_axis
            self.state['pedal_rest'] = sensor.pedal_rest
        # repouso dos gatilhos: sempre aplica nesta sessão (calibração real)
        vol['freio_repouso'], vol['acel_repouso'] = sensor.pedal_rest
        if sensor.gyro_axis >= 0 and int(cfg_s.get('salvar_calibracao', 1)):
            cfg_s['eixo_giro'] = sensor.gyro_axis
            cfg_s['sinal_giro'] = sensor.gyro_sign
            cfg_s['gyro_dps_por_lsb'] = sensor.gyro_scale
            log('calibração guardada na config (eixo%d, sinal %+d, '
                'escala %g dps/LSB)'
                % (sensor.gyro_axis, int(sensor.gyro_sign),
                   sensor.gyro_scale))
        self._aplicar_pedais()   # device no ar reacende com o repouso novo

    def reconectar(self):
        self._reopen = True

    def set_mapa(self, mapa):
        """Aplica o mapa de botões ao vivo (device não recriado)."""
        self.cfg['mapa_botoes'] = dict(mapa)
        steer = self._steer
        if steer:
            steer.set_mapa(mapa)

    def set_modo(self, modo):
        """Troca o perfil do dispositivo (xbox / volante) ao vivo."""
        self.cfg.setdefault('dispositivo', {})['modo'] = modo
        self._trocar_modo = True

    def _aplicar_pedais(self):
        """Empurra repouso/zona morta/curva atuais p/ o device do modo volante.

        Chamada a cada calibração: se o controle reconectar (BT↔USB) ou o
        usuário recalibrar no meio do jogo, o repouso novo dos gatilhos entra
        no device já rodando (antes, ficava o repouso da criação do device)."""
        steer = self._steer
        if not steer or steer.modo != 'volante':
            return
        vol = self.cfg.get('volante', {})
        steer.set_pedais(vol.get('freio_zona_morta', 20.0),
                         vol.get('freio_curva', 1.0),
                         vol.get('acel_zona_morta', 20.0),
                         vol.get('acel_curva', 1.0),
                         vol.get('freio_repouso', 0.0),
                         vol.get('acel_repouso', 0.0))

    def set_pedais(self, freio_dz=20.0, freio_curva=1.0, acel_dz=20.0,
                   acel_curva=1.0, freio_rep=0.0, acel_rep=0.0):
        """Ajuste dos pedais ao vivo (modo volante)."""
        vol = self.cfg.setdefault('volante', {})
        vol.update({'freio_zona_morta': freio_dz, 'freio_curva': freio_curva,
                    'acel_zona_morta': acel_dz, 'acel_curva': acel_curva,
                    'freio_repouso': freio_rep, 'acel_repouso': acel_rep})
        steer = self._steer
        if steer:
            steer.set_pedais(freio_dz, freio_curva, acel_dz, acel_curva,
                             freio_rep, acel_rep)

    def encerrar(self):
        self._stop = True
        self._grab_soltar()

    # ---- internos ----
    def _wait(self, seconds):
        fim = time.monotonic() + seconds
        while time.monotonic() < fim:
            if self._stop:
                return False
            time.sleep(0.1)
        return True

    def _abrir_dispositivo(self):
        while not self._stop:
            path = M.find_ds_hidraw()
            if path:
                try:
                    return (os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC),
                            path)
                except PermissionError:
                    self.status(_t('sem permissão em %s — rode: sudo tilt2drive-gui') %
                                COR_ERR)
            else:
                self.status(_t('aguardando DualSense (conecte pelo Bluetooth)...'),
                            COR_MUT)
            if not self._wait(1.5):
                return None, None
        return None, None

    # ---- laço principal ----
    def run(self):
        fd = None
        path = None
        sensor = None
        steer = None
        ultima = time.monotonic()
        try:
            while not self._stop:
                if fd is None:
                    fd, path = self._abrir_dispositivo()
                    if fd is None or self._stop:
                        break
                    self.status(_t('calibrando — segure o controle parado...'), COR_WARN)
                    try:
                        sensor = M.Sensor(copy.deepcopy(self.cfg['sensor']))
                        sensor.calibrate(fd)
                    except (RuntimeError, OSError) as e:
                        self.status(_t('erro: %s') % e, COR_ERR)
                        with self._lock:
                            self._logs.append(_t('calibração: %s') % e)
                        try:
                            os.close(fd)
                        except OSError:
                            pass
                        fd = None
                        if not self._wait(2.5):
                            break
                        continue
                    self.sensor = sensor
                    self._persistir_calibracao(sensor)
                    modo = self.cfg.get('dispositivo', {}).get('modo', 'xbox')
                    if steer is None or steer.modo != modo:
                        try:
                            if steer is not None:
                                steer.close()
                            steer = M.Steer(modo, self.cfg.get('mapa_botoes'),
                                            self.cfg.get('volante'))
                            with self._lock:
                                self.state['virtual'] = True
                                self._logs.append(
                                    'dispositivo virtual: %s (modo %s)'
                                    % (steer.PERFIL[modo]['name'], modo))
                        except OSError as e:
                            steer = None
                            with self._lock:
                                self._logs.append(_t('uinput: %s') % e)
                    self._steer = steer
                    self._pub_eixos(sensor)
                    self.status(_t('ativo: %s') % path, COR_OK)
                    self._grab_renovar_se(path)
                    ultima = time.monotonic()
                if self._trocar_modo:
                    self._trocar_modo = False
                    novo = self.cfg.get('dispositivo', {}).get('modo', 'xbox')
                    if steer is None or steer.modo != novo:
                        log_msg = 'dispositivo virtual: %s (modo %s)' % (
                            M.Steer.PERFIL[novo]['name'], novo)
                        try:
                            if steer is not None:
                                steer.close()
                                self._steer = None
                            steer = M.Steer(novo, self.cfg.get('mapa_botoes'),
                                            self.cfg.get('volante'))
                            self._steer = steer
                            with self._lock:
                                self._logs.append(log_msg)
                        except OSError as e:
                            steer = None
                            with self._lock:
                                self._logs.append(_t('uinput: %s') % e)
                if self._recal:
                    self._recal = False
                    self.status(_t('recalibrando — segure o controle parado...'),
                                COR_WARN)
                    try:
                        sensor = M.Sensor(copy.deepcopy(self.cfg['sensor']))
                        sensor.calibrate(fd)
                        self.sensor = sensor
                        self._persistir_calibracao(sensor)
                        self._pub_eixos(sensor)
                        self.status(_t('ativo: %s') % path, COR_OK)
                    except (RuntimeError, OSError) as e:
                        self.status(_t('erro: %s') % e, COR_ERR)
                        with self._lock:
                            self._logs.append(_t('recalibração: %s') % e)
                if self._reopen:
                    self._reopen = False
                    try:
                        os.close(fd)
                    except OSError:
                        pass
                    fd = None
                    self._wait(0.4)
                    continue
                r, _, _ = select.select([fd], [], [], 0.3)
                if not r:
                    if not os.path.exists(path):
                        self.status(_t('desconectado — aguardando...'), COR_WARN)
                        try:
                            os.close(fd)
                        except OSError:
                            pass
                        fd = None
                        self._wait(0.4)
                    continue
                self._nrep += 1
                try:
                    buf = os.read(fd, 256)
                except (BlockingIOError, OSError):
                    continue
                if not buf:
                    continue
                apertados = M.botoes_apertados(buf, M.DS_BASE.get(buf[0], 2))
                if apertados != self._ult_botoes:
                    self._ult_botoes = apertados
                    with self._lock:
                        self.state['botoes'] = apertados
                try:
                    out = sensor.step(buf, M.cfg_direcao(self.cfg))
                    if out is None:
                        continue
                    if steer:
                        steer.feed(buf, int(round(
                            max(-1.0, min(1.0, out)) * 32767)),
                            M.DS_BASE.get(buf[0], 2))
                except Exception:
                    # relatório ruim/cfg em transição não pode matar o motor
                    continue
                with self._lock:
                    s = self.state
                    s['angle'] = sensor.angle
                    s['out'] = out
                    s['dps'] = sensor.dps
                    accel = sensor._pair(buf)[0]
                    g = tuple(v / ACC_G for v in accel)
                    s['accel_g'] = g
                    s['ga'] = math.hypot(*g)
                    # pedais p/ o HUD (0..1): no modo volante é o valor
                    # processado (o que chega no jogo); no xbox, gatilho cru
                    b_ds = M.DS_BASE.get(buf[0], 2)
                    if steer and steer.modo == 'volante':
                        f = steer._pedal(buf[b_ds + 4], 'freio') / 1020.0
                        a_ = steer._pedal(buf[b_ds + 5], 'acel') / 1020.0
                    else:
                        f = buf[b_ds + 4] / 255.0
                        a_ = buf[b_ds + 5] / 255.0
                    s['pedais'] = (float(max(0.0, min(1.0, f))),
                                   float(max(0.0, min(1.0, a_))))
                agora = time.monotonic()
                if agora - ultima >= 1.0:
                    with self._lock:
                        self.state['rps'] = self._nrep / (agora - ultima)
                    self._nrep = 0
                    ultima = agora
        except Exception as e:
            self.status(_t('erro inesperado: %r') % e, COR_ERR)
            with self._lock:
                self._logs.append(_t('engine: %r') % e)
        finally:
            if steer:
                try:
                    steer.emit(0)
                    steer.close()
                except OSError:
                    pass
            if fd:
                try:
                    os.close(fd)
                except OSError:
                    pass
            self.status(_t('motor parado'), COR_MUT)

    def _pub_eixos(self, sensor):
        with self._lock:
            self.state['eixos'] = (sensor.gyro_axis, int(sensor.gyro_sign),
                                   sensor.gyro_scale, sensor.accel_off,
                                   sensor.gyro_off)


def salvar_config(cfg, path=CONF_PATH):
    d, s = cfg['direcao'], cfg['sensor']
    dv = cfg.get('direcao_volante', M.DEFAULTS['direcao_volante'])
    disp = cfg.get('dispositivo', {'modo': 'xbox'})
    mapa = cfg.get('mapa_botoes', Steer.MAPA_PADRAO)
    vol = cfg.get('volante', M.DEFAULTS['volante'])
    linhas_mapa = '\n'.join(
        '%-10s = %s' % (k, mapa.get(k, Steer.MAPA_PADRAO[k]))
        for k in Steer.DS_NAMES)
    texto = """# tilt2drive — configuração (gerada pela GUI em {data})

[direcao]
# condução no modo CONTROLE (device xbox)
modo = {modo}           # angulo | taxa
angulo_max = {angulo_max}
zona_morta = {zona_morta}
suavizacao_tau = {tau}
taxa_giro_total = {taxa}
inverter = {inv}
curva = {curva}

[direcao_volante]
# condução independente no modo VOLANTE
modo = {v_modo}           # angulo | taxa
angulo_max = {v_angulo_max}
zona_morta = {v_zona_morta}
suavizacao_tau = {v_tau}
taxa_giro_total = {v_taxa}
inverter = {v_inv}
curva = {v_curva}

[sensor]
gyro_dps_por_lsb = {gyro}
sinal_giro = {sinal}
peso_accelerometro = {peso}
eixo_vert = {ev}
eixo_lat = {el}
# eixo_giro: -1 = auto (detecta); 0/1/2 = fixo (x/y/z)
eixo_giro = {eg}
salvar_calibracao = {salv}

[dispositivo]
modo = {disp_modo}      # xbox | volante

[volante]
# config do modo volante ("Tilt2Drive Racing Wheel")
gir_max = {gir_max}
freio_zona_morta = {f_dz}
acel_zona_morta = {a_dz}
freio_curva = {f_curva}
acel_curva = {a_curva}
freio_repouso = {f_rep}
acel_repouso = {a_rep}

[ui]
# interface: tema (escuro | claro) e idioma (pt | en)
tema = {ui_tema}
idioma = {ui_idioma}

[mapa_botoes]
# entradas do DualSense -> saídas do controle virtual
{mapa}
""".format(data=time.strftime('%Y-%m-%d %H:%M'),
           modo=d['modo'], angulo_max=d['angulo_max'],
           zona_morta=d['zona_morta'], tau=d['suavizacao_tau'],
           taxa=d['taxa_giro_total'], inv=int(d['inverter']),
           curva=d.get('curva', 1.0),
           peso=s['peso_accelerometro'], ev=int(s['eixo_vert']),
           el=int(s['eixo_lat']), eg=int(s['eixo_giro']),
           gyro=float(s.get('gyro_dps_por_lsb', 0.0009765625)),
           sinal=float(s.get('sinal_giro', 1.0)),
           salv=int(s.get('salvar_calibracao', 1)),
           disp_modo=disp.get('modo', 'xbox'), mapa=linhas_mapa,
           gir_max=float(vol.get('gir_max', 900.0)),
           f_dz=float(vol.get('freio_zona_morta', 20.0)),
           a_dz=float(vol.get('acel_zona_morta', 20.0)),
           f_curva=float(vol.get('freio_curva', 1.0)),
           a_curva=float(vol.get('acel_curva', 1.0)),
           f_rep=float(vol.get('freio_repouso', 0.0)),
           a_rep=float(vol.get('acel_repouso', 0.0)),
           v_modo=dv['modo'], v_angulo_max=dv['angulo_max'],
           v_zona_morta=dv['zona_morta'], v_tau=dv['suavizacao_tau'],
           v_taxa=dv['taxa_giro_total'], v_inv=int(dv['inverter']),
           v_curva=dv.get('curva', 1.0),
           ui_tema=cfg.get('ui', {}).get('tema', 'escuro'),
           ui_idioma=cfg.get('ui', {}).get('idioma', 'pt'))
    with open(path, 'w') as fh:
        fh.write(texto)


