    def _montar_mapa(self):
        """Mapa de botões: DualSense desenhado no canvas; botão pressionado
        acende azul na posição certa; clique abre a janela de função."""
        mapa_quad = ctk.CTkFrame(self._tab_mapa, fg_color=COR_PAINEL2,
                                 corner_radius=10)
        self._mapa_frame = mapa_quad
        ctk.CTkLabel(
            mapa_quad, text=_t('MAPA DE BOTÕES  ·  acesa (vermelho) = '
                               'pressionado  ·  clique um botão para '
                               'escolher a função'),
            font=F_TIT, text_color=COR_MUT).pack(anchor='w', padx=12,
                                                 pady=(12, 2))
        c = tk.Canvas(mapa_quad, width=640, height=340, bg=COR_CARD,
                      highlightthickness=1, highlightbackground=COR_GRADE)
        c.pack(anchor='center', padx=12, pady=(2, 12))
        self._mapa_canv = c
        self._mapa_cells = {}
        self._mapa_vars = {}
        self._mapa_vis = {}
        self._mapa_base = {}
        self._botoes_ultimo = frozenset()
        self._mapa_modo = 'vetor'
        self._mapa_ptos = {}   # nome -> (x, y, r) no canvas
        self._mapa_ret = {}    # nome -> (x1, y1, x2, y2) no canvas

        def rrect(x1, y1, x2, y2, r, fill, outline=COR_GRADE, w=1):
            r = max(0.0, min(r, (x2 - x1) / 2.0, (y2 - y1) / 2.0))
            pts = (x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r,
                   x2, y2, x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r,
                   x1, y1 + r, x1, y1)
            return c.create_polygon(*pts, fill=fill, outline=outline,
                                    width=w, smooth=True)

        def txt(x, y, s, cor=COR_MUT, f=('DejaVu Sans Condensed', 10), anc='n'):
            return c.create_text(x, y, text=s, fill=cor, font=f, anchor=anc)

        info_def = 'clique um botão do controle para escolher a função'
        info = c.create_text(68, 13, anchor='w', fill=COR_MUT,
                             font=('DejaVu Sans Condensed', 10), text=info_def)

        def hov_nome(nome):
            saida = self.cfg.get('mapa_botoes', {}).get(
                nome, Steer.MAPA_PADRAO.get(nome, 'none'))
            return '  %s → %s' % (ROTULOS_DS.get(nome, nome),
                                       ROTULOS_SAI.get(saida, saida))

        def ent(e, nome):
            c.itemconfig(info, text=hov_nome(nome))

        def sai(_e):
            c.itemconfig(info, text=info_def)

        def liga(nome, item, base, clique=True):
            """Item do mapa: guarda cor base; liga clique/hover por item
            (modo vetor). No modo imagem o clique é por proximidade no
            canvas inteiro (anel com fill='' só recebe clique na borda)."""
            self._mapa_vis[nome] = item
            self._mapa_base[nome] = base
            if clique:
                c.tag_bind(item, '<Button-1>',
                           lambda _e, nm=nome: self._mapa_dialogo(nm))
            c.tag_bind(item, '<Enter>', lambda e, nm=nome: ent(e, nm))
            c.tag_bind(item, '<Leave>', sai)
        if self._mapa_fundo(c, liga):
            c.configure(cursor='hand2')

            def clique_mapa(e):
                nm = self._mapa_no(e.x, e.y)
                if nm:
                    self._mapa_dialogo(nm)

            def mov_mapa(e):
                nm = self._mapa_no(e.x, e.y)
                c.itemconfig(info, text=(hov_nome(nm) if nm else info_def))

            c.bind('<Button-1>', clique_mapa)
            c.bind('<Motion>', mov_mapa)
            return

        # corpo do controle (contorno arredondado, vista de cima)
        c.create_polygon(
            98, 80, 128, 56, 210, 44, 320, 42, 430, 44, 512, 56, 542, 80,
            574, 124, 560, 200, 520, 244, 484, 256, 444, 228, 396, 214,
            244, 214, 196, 228, 156, 256, 120, 244, 80, 200, 66, 124,
            fill='#1b2230', outline=COR_GRADE, width=2, smooth=True)

        # touchpad (o clique é o botão 'touchpad')
        tp = rrect(292, 56, 348, 96, 10, '#33363f')
        c.create_line(292, 76, 348, 76, fill=COR_CARD, width=2)
        txt(320, 108, 'touchpad (clique)')
        liga('touchpad', tp, '#33363f')

        # create / options
        cr = rrect(260, 100, 270, 128, 5, '#33363f')
        txt(265, 136, 'Create')
        liga('create', cr, '#33363f')
        op = rrect(370, 100, 380, 128, 5, '#33363f')
        txt(375, 136, 'Options')
        liga('options', op, '#33363f')

        # sticks (pressionar = L3/R3)
        for nome, sx in (('l3', 198), ('r3', 442)):
            c.create_oval(sx - 23, 95, sx + 23, 141, fill='#151b26',
                          outline='#101116', width=3)
            inn = c.create_oval(sx - 11, 107, sx + 11, 129, fill='#33363f',
                                outline='#101116', width=2)
            txt(sx, 148, nome.upper())
            liga(nome, inn, '#33363f')

        # L1 / R1
        l1 = rrect(100, 34, 168, 52, 9, '#33363f')
        txt(134, 43, 'L1', COR_TXT, ('DejaVu Sans Condensed', 10, 'bold'), 'center')
        liga('l1', l1, '#33363f')
        r1 = rrect(472, 34, 540, 52, 9, '#33363f')
        txt(506, 43, 'R1', COR_TXT, ('DejaVu Sans Condensed', 10, 'bold'), 'center')
        liga('r1', r1, '#33363f')

        # d-pad (4 botões separados em cruz)
        for nome, x1, y1, x2, y2, t_pts in (
                ('cima', 127, 177, 153, 200,
                 (133, 195, 147, 195, 140, 183)),
                ('baixo', 127, 210, 153, 233,
                 (133, 215, 147, 215, 140, 227)),
                ('esquerda', 112, 192, 133, 218,
                 (129, 198, 129, 212, 117, 205)),
                ('direita', 147, 192, 168, 218,
                 (151, 198, 151, 212, 163, 205))):
            arm = rrect(x1, y1, x2, y2, 5, '#33363f')
            c.create_polygon(*t_pts, fill=COR_CARD, outline='')
            liga(nome, arm, '#33363f')

        # botões do rosto
        for nome, cx, cy, sym in (('quadrado', 461, 206, '□'),
                                  ('triangulo', 484, 183, '△'),
                                  ('cruz', 484, 231, '✕'),
                                  ('circulo', 507, 206, '○')):
            ov = c.create_oval(cx - 13, cy - 13, cx + 13, cy + 13,
                               fill='#33363f', outline='#151b26', width=2)
            g = c.create_text(cx, cy + 1, text=sym, fill='#9fb2d4',
                              font=('DejaVu Sans Condensed', 11, 'bold'))
