    def _grade_sliders(self, quad, sec, lista, linha_inicial, dentro=None,
                       dica=None):
        """Sliders CTk em 2 colunas; o valor é um chip digitável
        (Enter/FocusOut aplica; fora da faixa corta; inválido volta)."""
        grade = dentro or ctk.CTkFrame(quad, fg_color='transparent')
        if dentro is None:
            grade.pack(fill='x', padx=12, pady=(2, 10))
        for i, (chave, rotulo, mn, mx, passo) in enumerate(lista):
            cell = ctk.CTkFrame(grade, fg_color='transparent')
            cell.grid(row=linha_inicial + i // 2, column=i % 2,
                      sticky='nwe', padx=6, pady=3)
            ctk.CTkLabel(cell, text=_t(rotulo), text_color=COR_MUT,
                         wraplength=210, justify='left', anchor='w',
                         font=F_SUP).pack(anchor='w', fill='x')
            var = tk.DoubleVar(value=float(self.cfg.get(sec, {}).get(
                chave, M.DEFAULTS.get(sec, {}).get(chave, 0.0))))
            val_var = tk.StringVar()
            linha = ctk.CTkFrame(cell, fg_color='transparent')
            linha.pack(fill='x')
            passos = max(1, int(round((mx - mn) / passo)))
            slider = ctk.CTkSlider(
                linha, from_=mn, to=mx, number_of_steps=passos,
                height=22,
                command=lambda val, s=sec, ch=chave, vv=val_var:
                self._cb_slider(s, ch, val, vv),
                fg_color=COR_ITEM, progress_color=COR_ACAO,
                button_color='#f5f5f7', button_hover_color=COR_ACAO,
                corner_radius=4, button_corner_radius=8)
            slider.pack(side='left', fill='x', expand=True)
            slider.set(var.get())
            ent = ctk.CTkEntry(linha, textvariable=val_var, width=76,
                               height=28, corner_radius=6, font=F_MONO,
                               fg_color=COR_CARD, border_color=COR_GRADE,
                               text_color=COR_TXT, justify='center',
                               border_width=1)
            ent.pack(side='right', padx=(8, 0))

            def commit(_e=None, s=sec, ch=chave, mn=mn, mx=mx, var=var,
                       vv=val_var, sw=None):
                try:
                    sw = self._slider_w[(s, ch)]
                except KeyError:
                    pass
                bruto = (vv.get() or '').strip().replace(',', '.')
                try:
                    v = float(bruto)
                except ValueError:
                    vv.set('%g' % var.get())   # inválido: volta ao atual
                    return
                if v < mn or v > mx:           # fora da faixa: corta
                    v = max(mn, min(mx, v))
                var.set(v)
                if sw is not None:
                    sw.set(v)   # posiciona o knob (set() não dispara command)
                self._cb_slider(s, ch, v, vv)   # aplica sempre

            ent.bind('<Return>', commit)
            ent.bind('<KP_Enter>', commit)
            ent.bind('<FocusOut>', commit)
            ent.bind('<FocusIn>',
                     lambda _e, e=ent: e.select_range(0, 'end'))
            self._sliders[(sec, chave)] = (var, val_var)
            self._slider_w[(sec, chave)] = slider
            self._cb_slider(sec, chave, var.get(), val_var, aplicar=False)
        for col in range(2):
            grade.columnconfigure(col, weight=1, uniform='sliders')
        if dica:
            ctk.CTkLabel(quad, text=_t(dica), text_color=COR_MUT,
                         wraplength=520, justify='left', font=F_SUP) \
                .pack(fill='x', padx=16, pady=(0, 10))

