    def _reiniciar(self):
        """Salva e reabre o app — jeito 100% confiável de aplicar tema/
        idioma (todos os desenhos usam os tokens da nova paleta)."""
        try:
            salvar_config(self.cfg)
        except OSError:
            pass
        self.engine.encerrar()
        try:
            self.engine.join(timeout=1.0)
        except RuntimeError:
            pass
        os.execl(sys.executable, sys.executable,
                 os.path.realpath(sys.argv[0]))

