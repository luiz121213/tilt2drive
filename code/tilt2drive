def find_ds_hidraw():
    """Hidraw do DualSense (Bluetooth OU USB); dá preferência a USB
    (menor latência) quando os dois transportes estão conectados."""
    base = '/sys/class/hidraw'
    try:
        nomes = sorted(os.listdir(base))
    except OSError:
        return None
    melhor = None
    for nome in nomes:
        uevent = os.path.join(base, nome, 'device', 'uevent')
        try:
            with open(uevent) as fh:
                txt = fh.read().upper()
        except OSError:
            continue
        if not os.path.exists(os.path.join('/dev', nome)):
            continue
        if not (('054C' in txt and '0CE6' in txt) or 'DUALSENSE' in txt):
            continue
        # USB: uevent traz PRODUCT=054c/0ce6/... (ou HID_ID=0003:...);
        # Bluetooth: HID_ID=0005:...
        prior = 0 if ('PRODUCT=054C/0CE6' in txt or 'HID_ID=0003' in txt) \
            else 1
        if melhor is None or prior < melhor[0]:
            melhor = (prior, os.path.join('/dev', nome))
    return melhor[1] if melhor else None


def open_ds_or_wait():
    while True:
        path = find_ds_hidraw()
        if path:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
                log('DualSense encontrado em %s' % path)
                return fd, path
            except PermissionError:
                log('Sem permissão para ler %s.' % path)
                log('Rode com sudo: sudo tilt2drive')
                sys.exit(1)
        log('.', end='')
        time.sleep(2)


def read_reports(fd, seconds):
    out, t0 = [], time.monotonic()
    while time.monotonic() - t0 < seconds:
        r, _, _ = select.select([fd], [], [], 0.25)
        if not r:
            continue
        try:
            data = os.read(fd, 256)
        except (BlockingIOError, OSError):
            continue
        if not data:
            break
        out.append(data)
    return out


DS_KNOWN_LAYOUTS = {
    # (rid, gyro_off, accel_off) — struct do relatório começa no byte 2 (BT) ou 1 (USB)
    0x31: (17, 23),   # Bluetooth
    0x01: (16, 22),   # USB
}


def find_sensor_block(reports):
    """Acha o bloco de sensores. Retorna (rid, gyro_off, accel_off) ou None."""
    # 1) layouts conhecidos do DualSense ( Drivers/hid/hid-playstation.c)
    ids = {b[0] for b in reports}
    for rid, (go, ao) in DS_KNOWN_LAYOUTS.items():
        if rid in ids and all(len(b) >= ao + 8 for b in reports if b[0] == rid):
            return rid, go, ao
    # 2) fallback: vota em offsets, em qualquer ordem accel/gyro
    votes = {}
    for buf in reports:
        if len(buf) < 48:
            continue
        for off in range(8, len(buf) - 12):
            t1 = struct.unpack_from('3h', buf, off)
            t2 = struct.unpack_from('3h', buf, off + 6)
            m1 = math.sqrt(sum(v * v for v in t1))
            m2 = math.sqrt(sum(v * v for v in t2))
            # accel parado ~1g (8192 LSB/g); gyro parado ~0
            if (4000.0 <= m1 <= 12000.0 and m2 < 3500.0) or \
               (4000.0 <= m2 <= 12000.0 and m1 < 3500.0):
                votes[(buf[0], off)] = votes.get((buf[0], off), 0) + 1
    if not votes:
        return None
    (rid, off), _ = max(votes.items(), key=lambda kv: kv[1])
    m1s = m2s = 0.0
    n = 0
    for buf in reports:
        if len(buf) >= off + 12:
            m1s += math.hypot(*struct.unpack_from('3h', buf, off))
            m2s += math.hypot(*struct.unpack_from('3h', buf, off + 6))
            n += 1
    if m1s >= m2s:   # o triple maior é o acelerômetro (gravidade ~1g)
        return rid, off + 6, off
    return rid, off, off + 6


# ---------------------------------------------------------------------------
# sensor + filtro
# ---------------------------------------------------------------------------
class Sensor:
    def __init__(self, s):
        self.gyro_scale = s['gyro_dps_por_lsb']
        self.fusao = s['peso_accelerometro']
        self.gyro_axis = int(s.get('eixo_giro', -1))
        self.inverter = s.get('inverter', 1.0)
        self.gyro_sign = float(s.get('sinal_giro', 1.0))
        self.pedal_rest = (0.0, 0.0)    # (freio, acel) medido em repouso

        self.rid = None
        self.gyro_off = None
        self.accel_off = None
        self.mag_ref = None
        self.g0 = (0.0, 0.0, 0.0)          # gravidade de referência (neutro)
        self.gyro_sign = 1.0
        self.neutral_gyro = 0.0
        self.angle = 0.0
        self.dps = 0.0
        self._out = 0.0
        self._last_t = None

    def _pair(self, buf):
        accel = struct.unpack_from('3h', buf, self.accel_off)
        gyro = struct.unpack_from('3h', buf, self.gyro_off)
        return accel, gyro

    def calibrate(self, fd):
        log('')
        log('CALIBRANDO — segure o controle parado, na posição de jogar...')
        time.sleep(1)
        still = read_reports(fd, 1.2)
        if len(still) < 30:
            raise RuntimeError('nenhum relatório recebido do controle')
        blk = find_sensor_block(still)
        if blk is None:
            raise RuntimeError('não achei accel/gyro nos relatórios '
                               '(rode com --debug para investigar)')
        self.rid, self.gyro_off, self.accel_off = blk
        filt = [b for b in still if len(b) >= self.accel_off + 12]
        picked = [b for b in filt if b[0] == self.rid]
        a_sum = [0.0, 0.0, 0.0]
        n = 0
        for b in picked:
            accel, _ = self._pair(b)
            for i in range(3):
                a_sum[i] += accel[i]
            n += 1
        signed = [v / max(1, n) for v in a_sum]
        self.g0 = tuple(signed)
        self.mag_ref = math.sqrt(sum(v * v for v in signed))

        # gatilhos em repouso (parado): subtraímos depois, senão o carro
        # acelera/freia sozinho quando o gatilho não vale exatamente 0
        base = DS_BASE.get(self.rid, 2)
        pf = [b[base + 4] for b in picked if len(b) >= base + 6]
        pa = [b[base + 5] for b in picked if len(b) >= base + 6]
        if pf and pa:
            self.pedal_rest = (sum(pf) / len(pf), sum(pa) / len(pa))

        # fase de balanço: só quando o eixo NÃO está fixo nem guardado
        wig = []
        if self.gyro_axis < 0:
            log('Agora mova o controle para os LADOS (faça de conta que '
                'é um volante)...')
            wig = [b for b in read_reports(fd, 2.2)
                   if len(b) >= self.accel_off + 12 and b[0] == self.rid]
        gyrs, accs = [], []
        for b in wig:
            accel, gyro = self._pair(b)
            gyrs.append(gyro)
            accs.append(accel)
        # taxa de relatórios observada (para estimar escala do giroscópio)
        ritmo = max(1.0, (len(still) + len(wig)) / 3.4)   # rel/s
        if len(wig) > 20:
            melhor = None
            for axis in range(3):
                angs = [self._roll_accel(a, axis) for a in accs]
                rng = max(angs) - min(angs)
                if rng < 8.0:
                    continue
                dan = [(angs[j] - angs[j - 1]) for j in range(1, len(angs))]
                gv = [g[axis] for g in gyrs]
                v1 = sum(x * x for x in dan)
                v2 = sum(v * v for v in gv)
                if v1 < 1e-6 or v2 < 1e-6:
                    continue
                corr = sum(a * b for a, b in zip(dan, gv)) / math.sqrt(v1 * v2)
                if abs(corr) < 0.35:      # eixo errado tem correlação ~0
                    continue
                score = rng * abs(corr)
                if melhor is None or score > melhor[3]:
                    melhor = (axis, corr, rng, score)
            if melhor:
                axis, corr, rng, _ = melhor
                if self.gyro_axis < 0:
                    self.gyro_axis = axis
                self.gyro_sign = 1.0 if corr >= 0 else -1.0
                # escala: dângulo vs raw nos instantes de rotação forte
                angs = [self._roll_accel(a, self.gyro_axis) for a in accs]
                gv = [g[self.gyro_axis] for g in gyrs]
                num = deno = 0.0
                for j in range(1, len(angs)):
                    if abs(gv[j]) > 800.0:
                        num += (angs[j] - angs[j - 1]) * gv[j]
                        deno += gv[j] * gv[j]
                if deno > 0:
                    esc = ritmo * num / deno
                    if 1e-4 < esc < 0.02:
                        self.gyro_scale = esc
                log('Eixo de giro detectado: eixo%d (corr %+.2f, amplitude %.0f°, '
                    'escala %.6f dps/LSB)' % (axis, corr, rng, self.gyro_scale))
            else:
                if self.gyro_axis >= 0:
                    log('Eixo de giro fixado pelo config: eixo%d (sinal %+d) '
                        '— sem necessidade de balançar.'
                        % (self.gyro_axis, int(self.gyro_sign)))
                else:
                    log('Aviso: balanço fraco ou ambíguo — repita a calibração '
                        'girando o controle mais para os lados.')
        gv = [self._pair(b)[1][self.gyro_axis] for b in picked
              if self.gyro_axis >= 0]
        self.neutral_gyro = (sum(gv) / max(1, len(gv))) if gv else 0.0
        self._last_t = time.monotonic()
        log('Calibrado: accel@%d gyro@%d | eixo de giro=eixo%d (sinal %+d) | '
            'escala %.6g dps/LSB | invert=%+g'
            % (self.accel_off, self.gyro_off, self.gyro_axis,
               int(self.gyro_sign), self.gyro_scale, self.inverter))
        log('Pronto! HUD a seguir: incline o controle e veja o número.')

    def _roll_accel(self, accel, axis):
        """Ângulo (graus) da gravidade em torno do eixo `axis`, relativo ao neutro."""
        g0 = self.g0
        cx = g0[1] * accel[2] - g0[2] * accel[1]
        cy = g0[2] * accel[0] - g0[0] * accel[2]
        cz = g0[0] * accel[1] - g0[1] * accel[0]
        proj = (cx, cy, cz)[axis]
        dot = g0[0] * accel[0] + g0[1] * accel[1] + g0[2] * accel[2]
        return math.degrees(math.atan2(proj, dot))

    def step(self, buf, d):
        """d = dicionário de configuração de direção; retorno: -1..1 ou None."""
        if len(buf) < self.accel_off + 12 or buf[0] != self.rid:
            return None
        t = time.monotonic()
        dt = 0.005 if self._last_t is None else min(0.05, max(0.0005, t - self._last_t))
        self._last_t = t
        accel, gyro = self._pair(buf)

        self.dps = (gyro[self.gyro_axis] - self.neutral_gyro) \
            * self.gyro_scale * self.gyro_sign

        m = math.sqrt(sum(v * v for v in accel))
        valid = self.mag_ref and abs(m - self.mag_ref) < 0.25 * self.mag_ref
        # saturações do giroscópio (±32 °/s de teto do DualSense) não são
        # confiáveis para integrar — nesses instantes a gravidadade manda mais
        bruto = abs(gyro[self.gyro_axis])
        saturado = bruto > 30000 or (self.mag_ref and not valid and bruto > 16000)
        accel_angle = None
        if valid:
            accel_angle = self._roll_accel(accel, self.gyro_axis)

        integ = self.angle + self.dps * dt
        if accel_angle is not None:
            k = self.fusao
            if saturado:
                k = max(k, 0.5)          # movimento rápido: gravidade manda
            else:
                # divergência grande + giroscópio calmo = integrador errou
                # (recuperação rápida de movimentos ultra-rápidos)
                diverge = abs(integ - accel_angle)
                if diverge > 15.0 and abs(self.dps) < 10.0:
                    k = max(k, min(0.35, 0.02 + diverge / 400.0))
            self.angle = (1.0 - k) * integ + k * accel_angle
        else:
            self.angle = integ
        self.angle = max(-180.0, min(180.0, self.angle))

        # --- recentro automático: parado (~sem giro), segue a gravidade e
        # --- aprende o drift residual do giroscópio (precisão de centro).
        parado = self.mag_ref and abs(self.dps) < 2.0
        if parado:
            self._silencio = getattr(self, '_silencio', 0.0) + dt
            if self._silencio > 1.2:
                # assimila o neutro do giroscópio devagar (drift real)
                raw_g = gyro[self.gyro_axis]
                self.neutral_gyro += (raw_g - self.neutral_gyro) * min(0.5, dt * 0.6)
                # e puxa o ângulo para a gravidade (recentro firme)
                if accel_angle is not None:
                    k = min(0.35, dt * 2.0)
                    self.angle += (accel_angle - self.angle) * k
        else:
            self._silencio = 0.0

        dzone = d['zona_morta']
        if d['modo'] == 'taxa':
            target = self.dps / max(1.0, d['taxa_giro_total'])
        else:
            a = abs(self.angle)
            if a <= dzone:
                target = 0.0
            else:
                sign = 1.0 if self.angle > 0 else -1.0
                norm = min(1.0, (a - dzone) / max(1.0, d['angulo_max'] - dzone))
                curva = float(d.get('curva', 1.0))
                if curva != 1.0:
                    norm = norm ** max(0.05, curva)
                target = sign * norm
        target = max(-1.0, min(1.0, target)) * self.inverter
        tau = d['suavizacao_tau']
        if tau > 0:
            # filtro adaptativo: perto do centro 2x mais lento (precisão),
            # nos extremos mantém a resposta rápida
            fator_centro = 1.0 + 1.0 * (1.0 - min(1.0, abs(target)))
            alpha = 1.0 - math.exp(-dt / (tau * fator_centro))
            out = self._out + alpha * (target - self._out)
            if abs(target) < 0.03:
                out = target
        else:
            out = target
        self._out = out
        return out


# ---------------------------------------------------------------------------
# HUD e modos
# ---------------------------------------------------------------------------
def hud(angle, out):
    width = 31
    pos = int(round((max(-1.0, min(1.0, out)) + 1) * (width - 1) / 2))
    bar = ['.'] * width
    bar[width // 2] = '|'
    bar[pos] = 'O'
    sys.stdout.write('\rângulo %+07.2f°  [%s]  direção %+05.1f%%   '
                     % (angle, ''.join(bar), out * 100.0))
    sys.stdout.flush()


def debug_line(sensor, buf):
    if len(buf) < 48:
        return 'report curto: len=%d' % len(buf)
    if sensor.rid is None or buf[0] != sensor.rid:
        return 'report id=0x%02X len=%d (aguardando id 0x%02X)' % \
               (buf[0], len(buf), sensor.rid or 0)
    accel, gyro = sensor._pair(buf)
    m = math.sqrt(sum(v * v for v in accel))
    dps = (gyro[sensor.gyro_axis] - sensor.neutral_gyro) * sensor.gyro_scale
    return 'id=0x%02X accel=%s mag=%.0f gyro=%s roll=%+7.1fdps ângulo=%+.2f' % \
           (buf[0], str(accel), m, str(gyro), dps, sensor.angle)


# ---------------------------------------------------------------------------
# configuração
# ---------------------------------------------------------------------------
def conf_padrao():
    """(ler, salvar): tilt2drive.conf, migrando do motion-f1.conf antigo."""
    novo = os.path.expanduser('~/.config/tilt2drive.conf')
    antigo = os.path.expanduser('~/.config/motion-f1.conf')
    if not os.path.exists(novo) and os.path.exists(antigo):
        return antigo, novo      # 1a execução pós-renome: lê o antigo,
    return novo, novo            # depois salvar_config já grava no novo


def load_cfg(path):
    cfg = copy.deepcopy(DEFAULTS)
    cp = configparser.ConfigParser(strict=False)
    cp.read(path)
    for sec in cfg:
        if sec in cp:
            for key, default in cfg[sec].items():
                try:
                    if isinstance(default, float):
                        cfg[sec][key] = cp.getfloat(sec, key, fallback=default)
                    elif isinstance(default, int):
                        cfg[sec][key] = cp.getint(sec, key, fallback=default)
                    else:
                        cfg[sec][key] = cp.get(sec, key, fallback=default)
                except (ValueError, configparser.Error):
                    pass  # mantém o padrão se a chave estiver confusa
            # valores de texto podem ter comentário inline ("# ...")
            for key, default in cfg[sec].items():
                if isinstance(default, str) and default not in ('angulo', 'taxa') \
                        and '#' in cfg[sec][key]:
                    cfg[sec][key] = cfg[sec][key].split('#')[0].strip()
    # migração: pedais antigos (zona_morta/curva compartilhadas) -> por pedal
    if cp.has_section('volante'):
        for novo, antigo, padrao in (('freio_zona_morta', 'pedal_zona_morta', 20.0),
                                     ('acel_zona_morta', 'pedal_zona_morta', 20.0),
                                     ('freio_curva', 'pedal_curva', 1.0),
                                     ('acel_curva', 'pedal_curva', 1.0)):
            if cp.has_option('volante', antigo) and \
                    not cp.has_option('volante', novo):
                try:
                    v = cp.getfloat('volante', antigo)
                    # 0.0 = valor de fábrica antigo (nunca ajustado): sem zona
                    # morta o ruído dos gatilhos aciona o pedal sozinho
                    cfg['volante'][novo] = v if v > 0 else padrao
                except (ValueError, configparser.Error):
                    pass
    return cfg


# ---------------------------------------------------------------------------
# laço principal
# ---------------------------------------------------------------------------
def run(cfg, debug=False):
    steer = None
    fd = None
    sensor = None
    path = None
    last_hud = 0.0
    try:
        log('Ao abrir: pareie o DualSense pelo Bluetooth e rode este comando.')
        while True:
            try:
                if fd is None:
                    fd, path = open_ds_or_wait()
                    if sensor is None:
                        sensor = Sensor(cfg['sensor'])
                    sensor.calibrate(fd)
                    vol = cfg.setdefault('volante', {})
                    vol['freio_repouso'], vol['acel_repouso'] = sensor.pedal_rest
                    if steer is None:
                        modo = cfg.get('dispositivo', {}).get('modo', 'xbox')
                        steer = Steer(modo, cfg.get('mapa_botoes'),
                                      cfg.get('volante'))
                        nome = steer.PERFIL[steer.modo]['name']
                        log('Dispositivo virtual criado: "%s" (modo %s).'
                            % (nome, steer.modo))
                    log('Convertendo... (Ctrl+C para sair)')
            except (RuntimeError, OSError) as e:
                log('Erro: %s' % e)
                if fd is not None:
                    os.close(fd)
                fd = None
                time.sleep(2)
                continue
            r, _, _ = select.select([fd], [], [], 0.5)
            if not r:
                if not os.path.exists(path):
                    log('')
                    log('Controle desconectado — aguardando reconexão...')
                    os.close(fd)
                    fd = None
                    sensor = None
                continue
            try:
                buf = os.read(fd, 256)
            except (BlockingIOError, OSError):
                fd = None
                sensor = None
                continue
            if not buf:
                os.close(fd)
                fd = None
                sensor = None
                continue
            if debug:
                print(debug_line(sensor, buf), flush=True)
                continue
            out = sensor.step(buf, cfg_direcao(cfg))
            if out is None:
                continue
            now = time.monotonic()
            if now - last_hud >= 0.03:
                hud(sensor.angle, out)
                last_hud = now
            steer.feed(buf, int(round(max(-1.0, min(1.0, out)) * 32767)),
                       DS_BASE.get(buf[0], 2))
    except KeyboardInterrupt:
        pass
    finally:
        log('')
        log('Encerrando...')
        if steer:
            steer.close()
        if fd:
            os.close(fd)
    return 0


def main():
    ap = argparse.ArgumentParser(
        description='Direção do F1 25 pelo giroscópio do DualSense '
                    '(só leitura do controle — nada é escrito para ele)')
    ap.add_argument('--conf', default=conf_padrao()[0])
    ap.add_argument('--debug', action='store_true', help='modo diagnóstico')
    args = ap.parse_args()
    sys.exit(run(load_cfg(args.conf), debug=args.debug))


if __name__ == '__main__':
    main()
