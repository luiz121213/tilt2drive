    def _montar_scroll(self):
        """Canvas rolável com todos os frames de config (janelas pequenas)."""
        self._scroll = tk.Canvas(self.root, bg=COR_BG, highlightthickness=0)
        barra = ttk.Scrollbar(self.root, orient='vertical',
                              command=self._scroll.yview)
        self._scroll.configure(yscrollcommand=barra.set)
        self._scroll.pack(side='left', fill='both', expand=True)
        barra.pack(side='right', fill='y')
        self._scroll_frame = tk.Frame(self._scroll, bg=COR_BG)
        self._scroll_window = self._scroll.create_window(
            (0, 0), window=self._scroll_frame, anchor='nw')
        self._scroll_frame.bind(
            '<Configure>',
            lambda _e: (self._scroll.configure(scrollregion=self._scroll.bbox('all')),
                        self._ajustar_largura()))
        self.root.bind('<Configure>', self._ajustar_largura)
        for ev in ('<MouseWheel>', '<Button-4>', '<Button-5>'):
            self._scroll.bind_all(ev, self._rolar)

    def _ajustar_largura(self, _ev=None):
        try:
            w = self._scroll.winfo_width()
            if w > 1:
                self._scroll.itemconfig(self._scroll_window, width=w)
        except Exception:
            pass

    def _rolar(self, ev):
        d = ev.delta / 120.0 if ev.type == '4' or ev.delta else \
            (-1 if ev.num == 4 else 1)
        # Button-4/5 no Linux: num 4 = cima (sobe), 5 = baixo (desce)
        if ev.num == 4:
            d = 1
        elif ev.num == 5:
            d = -1
        try:
            self._scroll.yview_scroll(-int(d), 'units')
        except Exception:
            pass

