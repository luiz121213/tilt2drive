    def _grade_sliders(self, quad, sec, lista, linha_inicial, dentro=None,
                       dica=None):
        """Coloca os sliders de uma seção em 2 colunas; o valor numérico
        é um campo digitável (Enter/FocusOut aplica; fora da faixa corta)."""
        grade = dentro or tk.Frame(quad, bg=COR_PAINEL)
        if dentro is None:
            grade.pack(fill='x', padx=10, pady=(2, 10))
        for i, (chave, rotulo, mn, mx, passo) in enumerate(lista):
            cell = tk.Frame(grade, bg=COR_PAINEL)
            cell.grid(row=linha_inicial + i // 2, column=i % 2,
                      sticky='nwe', padx=8, pady=3)
            tk.Label(cell, text=rotulo, bg=COR_PAINEL, fg=COR_MUT,
                     wraplength=210, justify='left', anchor='w',
                     font=('Segoe UI', 9)).pack(anchor='w', fill='x')
            var = tk.DoubleVar(value=float(self.cfg.get(sec, {}).get(
                chave, M.DEFAULTS.get(sec, {}).get(chave, 0.0))))
            val_var = tk.StringVar()
            linha = tk.Frame(cell, bg=COR_PAINEL)
            linha.pack(fill='x')
            ttk.Scale(linha, from_=mn, to=mx, variable=var,
                      command=lambda val, s=sec, ch=chave, vv=val_var:
                      self._cb_slider(s, ch, val, vv)).pack(
                side='left', fill='x', expand=True)
            ent = tk.Entry(linha, textvariable=val_var, width=7,
                           font=('Consolas', 10, 'bold'), bg=COR_BG,
                           fg=COR_TXT, relief='flat', justify='center',
                           highlightthickness=1,
                           highlightbackground=COR_GRADE,
                           insertbackground=COR_TXT)
            ent.pack(side='right', padx=(6, 0))

            def commit(_e=None, s=sec, ch=chave, mn=mn, mx=mx, var=var,
                       vv=val_var):
                bruto = (vv.get() or '').strip().replace(',', '.')
                try:
                    v = float(bruto)
                except ValueError:
                    vv.set('%g' % var.get())   # inválido: volta ao atual
                    return
                if v < mn or v > mx:           # fora da faixa: corta
                    v = max(mn, min(mx, v))
                var.set(v)                     # move o slider
                # ttk.Scale só dispara command ao interagir; aplica na mão:
                self._cb_slider(s, ch, v, vv)

            ent.bind('<Return>', commit)
            ent.bind('<KP_Enter>', commit)
            ent.bind('<FocusOut>', commit)
            ent.bind('<FocusIn>',
                     lambda _e, e=ent: e.selection_range(0, 'end'))
            self._sliders[(sec, chave)] = (var, val_var)
            self._cb_slider(sec, chave, var.get(), val_var, aplicar=False)
        for col in range(2):
            grade.columnconfigure(col, weight=1, uniform='sliders')
        if dica:
            tk.Label(quad, text=dica, bg=COR_PAINEL, fg=COR_MUT,
                     wraplength=430, justify='left',
                     font=('Segoe UI', 8)).pack(fill='x', padx=14,
                                                pady=(0, 6))

