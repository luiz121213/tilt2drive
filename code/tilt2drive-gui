    def _montar_mapa(self):
        """Mapa de botões: DualSense desenhado no canvas; botão pressionado
        acende azul na posição certa; clique abre a janela de função."""
        mapa_quad = tk.LabelFrame(
            self._scroll_frame,
            text=' Mapa de botões  (azul = pressionado; clique um botão '
                 'para escolher a função) ',
            bg=COR_PAINEL, fg=COR_TXT, bd=1, relief='flat')
        self._mapa_frame = mapa_quad
        mapa_quad.pack(fill='x', padx=12, pady=6)
        c = tk.Canvas(mapa_quad, width=640, height=340, bg=COR_BG,
                      highlightthickness=0)
        c.pack(anchor='center', padx=10, pady=(2, 8))
        self._mapa_canv = c
        self._mapa_cells = {}
        self._mapa_vars = {}
        self._mapa_vis = {}
        self._mapa_base = {}
        self._botoes_ultimo = frozenset()
        self._mapa_modo = 'vetor'
        self._mapa_ptos = {}   # nome -> (x, y, r) no canvas
        self._mapa_ret = {}    # nome -> (x1, y1, x2, y2) no canvas

        def rrect(x1, y1, x2, y2, r, fill, outline=COR_GRADE, w=1):
            r = max(0.0, min(r, (x2 - x1) / 2.0, (y2 - y1) / 2.0))
            pts = (x1 + r, y1, x2 - r, y1, x2, y1, x2, y1 + r, x2, y2 - r,
                   x2, y2, x2 - r, y2, x1 + r, y2, x1, y2, x1, y2 - r,
                   x1, y1 + r, x1, y1)
            return c.create_polygon(*pts, fill=fill, outline=outline,
                                    width=w, smooth=True)

        def txt(x, y, s, cor=COR_MUT, f=('Segoe UI', 8), anc='n'):
            return c.create_text(x, y, text=s, fill=cor, font=f, anchor=anc)

        info_def = 'clique um botão do controle para escolher a função'
        info = c.create_text(68, 13, anchor='w', fill=COR_MUT,
                             font=('Segoe UI', 8), text=info_def)

        def hov_nome(nome):
            saida = self.cfg.get('mapa_botoes', {}).get(
                nome, Steer.MAPA_PADRAO.get(nome, 'none'))
            return '  %s → %s' % (ROTULOS_DS.get(nome, nome),
                                       ROTULOS_SAI.get(saida, saida))

        def ent(e, nome):
