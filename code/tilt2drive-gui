    def _aplicar_cfg_ui(self):
        """Reflete o self.cfg atual em todos os widgets e no motor."""
        for sec in ('direcao', 'direcao_volante'):
            self.v_modo[sec].set(self.cfg[sec]['modo'])
            self.v_inv[sec].set(
                'invertida' if self.cfg[sec]['inverter'] < 0 else 'normal')
        disp = self.cfg.get('dispositivo', {}).get('modo', 'xbox')
        self._var_disp.set(disp)
        for (sec, chave) in list(self._sliders):
            var, val_var = self._sliders[(sec, chave)]
            var.set(float(self.cfg.get(sec, {}).get(chave, var.get())))
            self._cb_slider(sec, chave, var.get(), val_var, aplicar=False)
        s_cfg = self.cfg.get('sensor', {})
        eg = int(s_cfg.get('eixo_giro', -1))
        if hasattr(self, '_var_eixo'):
            self._var_eixo.set(['x', 'y', 'z'][min(2, max(0, eg))]
                               if eg >= 0 else 'auto')
        if hasattr(self, '_var_salvar_cal'):
            self._var_salvar_cal.set(
                'sim' if int(s_cfg.get('salvar_calibracao', 1)) else 'nao')
        mapa = self.cfg.get('mapa_botoes', {})
        for nome, var in self._mapa_vars.items():
            var.set(mapa.get(nome, Steer.MAPA_PADRAO.get(nome, 'none')))
        self.engine.set_mapa(mapa)
        vol = self.cfg.get('volante', {})
        self.engine.set_pedais(vol.get('freio_zona_morta', 20.0),
                               vol.get('freio_curva', 1.0),
                               vol.get('acel_zona_morta', 20.0),
                               vol.get('acel_curva', 1.0),
                               vol.get('freio_repouso', 0.0),
                               vol.get('acel_repouso', 0.0))
        self.engine.set_modo(disp)
        self._atualizar_visibilidade()

    def _restaurar_padroes(self):
        if not messagebox.askyesno(
                'Restaurar padrões',
                'Volta direção, sensor, volante, mapa de botões e o modo do '
                'dispositivo para os padrões de fábrica?'):
            return
        nova = copy.deepcopy(M.DEFAULTS)
        # trocas de uma chave só (atômicas p/ a thread do motor, que lê
        # cfg['direcao'] em loop — o cfg.clear() antigo deixava o dict vazio
        # no meio e podia matar o motor com KeyError):
        self.cfg['sensor'] = dict(nova['sensor'])       # {} = eixo/sinal auto
        self.cfg['mapa_botoes'] = dict(Steer.MAPA_PADRAO)
        for sec in ('direcao', 'direcao_volante', 'volante', 'dispositivo'):
            self.cfg.setdefault(sec, {}).update(nova.get(sec, {}))
        self._aplicar_cfg_ui()
        self.engine.reconectar()   # recalibra com as notas de fábrica
        with self.engine._lock:
            self.engine._logs.append('config restaurada para os padrões')

    def _preset_salvar(self):
        nome = simpledialog.askstring(
            'Salvar preset', 'Nome do preset (vai para a lista):',
            parent=self.root)
        if nome is None:
            return
        nome = nome.strip().replace('/', '-').replace('\\', '-')
        if not nome:
            return
        caminho = preset_path(nome)
        if os.path.exists(caminho) and not messagebox.askyesno(
                'Salvar preset', 'Preset "%s" já existe. Sobrescrever?' % nome):
            return
        try:
            salvar_config(self.cfg, caminho)
        except OSError as e:
            with self.engine._lock:
                self.engine._logs.append('erro ao salvar preset: %s' % e)
            return
        self._preset_combo['values'] = presets_lista()
        self._var_preset.set(nome)
        with self.engine._lock:
            self.engine._logs.append('preset "%s" salvo' % nome)

    def _cb_preset(self, _ev=None):
        nome = self._var_preset.get()
        if not nome or not os.path.exists(preset_path(nome)):
            return
        nova = M.load_cfg(preset_path(nome))
        self.cfg.clear()
        self.cfg.update(nova)
        self._aplicar_cfg_ui()
        self.engine.reconectar()   # recalibra com a config do preset
        with self.engine._lock:
            self.engine._logs.append('preset "%s" carregado' % nome)

    def _preset_excluir(self):
        nome = self._var_preset.get()
        if not nome:
            return
        if not messagebox.askyesno('Excluir preset',
                                   'Apagar o preset "%s"?' % nome):
            return
        try:
            os.remove(preset_path(nome))
        except OSError:
            pass
        self._var_preset.set('')
        self._preset_combo['values'] = presets_lista()
        with self.engine._lock:
            self.engine._logs.append('preset "%s" excluído' % nome)

